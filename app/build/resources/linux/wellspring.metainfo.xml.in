<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id><%= name %></id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name><%= productName %></name>
  <summary><%= description %></summary>
  <description>
    <p>
      Wellspring is a telemetry-free, privacy-respecting fork of Mailspring. It keeps everything
      that makes Mailspring great — a fast C++ sync engine based on Mailcore2 that uses roughly
      half the RAM and CPU of Nylas Mail, a modern composer, Unified Inbox, Snooze, Send Later,
      Mail Rules and Templates — while removing everything that phones home to the vendor.
    </p>
    <p>
      Nothing is reported to the vendor's servers: no telemetry, no crash uploads, no account or
      subscription required. The app talks only to your own mail accounts. Your credentials never
      leave your computer.
    </p>
  </description>

  <url type="homepage">https://github.com/teras/Wellspring</url>
  <url type="bugtracker">https://github.com/teras/Wellspring/issues</url>
  <url type="vcs-browser">https://github.com/teras/Wellspring</url>

  <launchable type="desktop-id"><%= desktopName %></launchable>

  <developer id="is.yot.wellspring">
    <name>Wellspring</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d7f0f8</color>
    <color type="primary" scheme_preference="dark">#152330</color>
  </branding>

  <content_rating type="oars-1.1" />

